APP_NAME=CompilerAI
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true

API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# SQLite local DB for easy local runtime execution
DATABASE_URL=sqlite+aiosqlite:///./compiler_ai.db

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

OPENAI_API_KEY=mock-key-fallback-active
GOOGLE_API_KEY=mock-key-fallback-active

PIPELINE_TIMEOUT_SECONDS=120
MAX_REPAIR_ITERATIONS=3
STRICT_MODE=false
