# ─────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────
APP_NAME=CompilerAI
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true

# ─────────────────────────────────────────────────────────
# API
# ─────────────────────────────────────────────────────────
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# ─────────────────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/compiler_ai

# ─────────────────────────────────────────────────────────
# LLM Provider  (openai | gemini)
# ─────────────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# OpenAI
OPENAI_API_KEY=sk-...your-key-here...

# Google Gemini
GOOGLE_API_KEY=AI...your-key-here...

# ─────────────────────────────────────────────────────────
# Pipeline settings
# ─────────────────────────────────────────────────────────
PIPELINE_TIMEOUT_SECONDS=120
MAX_REPAIR_ITERATIONS=3
STRICT_MODE=false
